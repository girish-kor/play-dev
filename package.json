{
  "name": "play-dev",
  "version": "1.0.0",
  "description": "PLAY-DEV: The ultimate React UI component library for building professional game interfaces (HUD, menus, inventory) and developer tools. Optimized for performance, accessibility, and rapid game development.",
  "keywords": [
    "react",
    "ui",
    "game",
    "components",
    "hud",
    "gamedev",
    "react-component-library",
    "game-development",
    "ui-kit",
    "react-hooks",
    "typescript"
  ],
  "homepage": "https://github.com/girish-kor/play-dev#readme",
  "bugs": {
    "url": "https://github.com/girish-kor/play-dev/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/girish-kor/play-dev.git"
  },
  "license": "MIT",
  "author": {
    "name": "Girish Kor",
    "email": "girishkor5@gmail.com",
    "url": "https://github.com/girish-kor"
  },
  "type": "commonjs",
  "files": [
    "dist",
    "Document.md",
    "README.md",
    "banner.png"
  ],
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsup",
    "test": "jest",
    "lint": "eslint src --ext .ts,.tsx",
    "format": "prettier --write src",
    "docs": "tsx scripts/generate-docs-md.ts",
    "ci": "npm run lint && npm run format && npm run test && npm run docs && npm run build"
  },
  "peerDependencies": {
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "styled-components": "^6.5.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/jest": "^30.0.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@types/styled-components": "^5.1.36",
    "@typescript-eslint/eslint-plugin": "^8.69.0",
    "@typescript-eslint/parser": "^8.69.0",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "jest": "^30.5.1",
    "jest-environment-jsdom": "30.5.1",
    "prettier": "^3.9.6",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "styled-components": "^6.5.3",
    "ts-jest": "^29.4.12",
    "tsup": "8.5.1",
    "tsx": "4.23.13",
    "typescript": "6.0.3"
  },
  "overrides": {
    "esbuild": "0.27.2"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "funding": {
    "type": "individual",
    "url": "https://github.com/sponsors/girish-kor"
  }
